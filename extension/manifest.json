{
  "manifest_version": 3,
  "name": "Sakura 陪看框",
  "version": "0.3.21",
  "description": "把浏览器里正在播放的视频位置和画面报给本机的 Sakura 陪看插件。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:9377/*",
    "http://localhost:9377/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Sakura 陪看框"
  }
}
